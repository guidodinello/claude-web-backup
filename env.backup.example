# Copy this file to .env.backup and fill in real session tokens.
# .env.backup is gitignored (matched by the .env* rule) — never commit real tokens.
#
# One CLAUDE_BACKUP_TOKEN_<SLUG> per account to back up. <SLUG> becomes the
# account's folder name under CLAUDE_BACKUP_DIR (lowercased).

CLAUDE_BACKUP_TOKEN_PERSONAL=sk-ant-sid01-...
CLAUDE_BACKUP_TOKEN_WORK=sk-ant-sid01-...

# Output root. Layout: {dir}/{account_slug}/{project_slug}/{project.md,docs/,conversations/}
CLAUDE_BACKUP_DIR=/home/guido/claude-backup
